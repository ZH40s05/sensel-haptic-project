#: tools/sensel_haptic_gui.py
msgid "Privileged helper returned incomplete Sensel state"
msgstr "特權 helper 傳回的 Sensel 狀態不完整"

#: tools/sensel_haptic_gui.py
msgid "Privileged helper returned an invalid haptic intensity"
msgstr "特權 helper 傳回了無效的觸覺強度"

#: tools/sensel_haptic_gui.py
msgid "Privileged helper returned an invalid TrackPoint button state"
msgstr "特權 helper 傳回了無效的 TrackPoint 按鈕狀態"

#, python-brace-format
#: tools/sensel_haptic_gui.py
msgid "Privileged helper not found: {path}"
msgstr "找不到特權 helper：{path}"

#: tools/sensel_haptic_gui.py
msgid "pkexec was not found; cannot access the Sensel device"
msgstr "找不到 pkexec，無法存取 Sensel 裝置"

#, python-brace-format
#: tools/sensel_haptic_gui.py
msgid "Helper exited with status {status}"
msgstr "helper 以狀態 {status} 結束"

#: tools/sensel_haptic_gui.py
msgid "Sensel Haptic Touchpad"
msgstr "Sensel 觸覺觸控板"

#: tools/sensel_haptic_gui.py
msgid "Looking for a Sensel Haptic Touchpad…"
msgstr "正在尋找 Sensel 觸覺觸控板…"

#: tools/sensel_haptic_gui.py
msgid "Touchpad Settings"
msgstr "觸控板設定"

#: tools/sensel_haptic_gui.py
msgid "Device"
msgstr "裝置"

#: tools/sensel_haptic_gui.py
msgid "HID device:"
msgstr "HID 裝置："

#: tools/sensel_haptic_gui.py
msgid "Refresh"
msgstr "重新整理"

#: tools/sensel_haptic_gui.py
msgid "Haptic Feedback"
msgstr "觸覺回饋"

#: tools/sensel_haptic_gui.py
msgid "Haptics Intensity"
msgstr "觸覺強度"

#: tools/sensel_haptic_gui.py
msgid "Click Force"
msgstr "點擊力度"

#: tools/sensel_haptic_gui.py
msgid "Fine adjustment: 1–255 main click register units. Windows presets: 60 / 82 / 95 (120 / 164 / 190 Gf)."
msgstr "精細調整：1–255 主點擊暫存器單位。Windows 預設：60 / 82 / 95（120 / 164 / 190 Gf）。"

#: tools/sensel_haptic_gui.py
msgid "Apply"
msgstr "套用"

#: tools/sensel_haptic_gui.py
msgid "TrackPoint Buttons"
msgstr "TrackPoint 按鈕"

#: tools/sensel_haptic_gui.py
msgid "Enable TrackPoint Buttons"
msgstr "啟用 TrackPoint 按鈕"

#: tools/sensel_haptic_gui.py
msgid "TrackPoint Click Force"
msgstr "TrackPoint 點擊力度"

#: tools/sensel_haptic_gui.py
msgid "Fine adjustment: 1–255 Windows 3HB register units. Windows presets: 28 / 38 / 60."
msgstr "精細調整：1–255 個 Windows 3HB 暫存器單位。Windows 預設：28 / 38 / 60。"

#: tools/sensel_haptic_gui.py
msgid "Sensel Haptic Touchpad was not detected. Check the connection and click Refresh."
msgstr "未偵測到 Sensel 觸覺觸控板。請檢查裝置連線，然後點選「重新整理」。"

#: tools/sensel_haptic_gui.py
msgid "Reading settings from the device…"
msgstr "正在從裝置讀取設定…"

#, python-brace-format
#: tools/sensel_haptic_gui.py
msgid "Failed to read device settings: {error}"
msgstr "讀取裝置設定失敗：{error}"

#, python-brace-format
#: tools/sensel_haptic_gui.py
msgid "The device returned invalid data: {error}"
msgstr "裝置傳回的資料無效：{error}"

#: tools/sensel_haptic_gui.py
msgid "Settings read from the device. Changes to sliders and switches are saved to the device."
msgstr "已從裝置讀取設定。滑桿和開關的變更會儲存至裝置。"

#, python-brace-format
#: tools/sensel_haptic_gui.py
msgid "Applying {label}…"
msgstr "正在套用 {label}…"

#, python-brace-format
#: tools/sensel_haptic_gui.py
msgid "{label} failed: {error}"
msgstr "{label}失敗：{error}"

#, python-brace-format
#: tools/sensel_haptic_gui.py
msgid "{label} failed"
msgstr "{label}失敗"

#, python-brace-format
#: tools/sensel_haptic_gui.py
msgid "{label} applied and saved."
msgstr "{label}已套用並儲存。"

#: tools/sensel_haptic_gui.py
msgid "Pending Changes"
msgstr "待儲存的變更"

#: tools/sensel_haptic_gui.py
msgid "You have unsaved changes"
msgstr "有未儲存的變更"

#: tools/sensel_haptic_gui.py
msgid "All changes saved"
msgstr "所有變更已儲存"

#: tools/sensel_haptic_gui.py
msgid "Save"
msgstr "儲存"

#: tools/sensel_haptic_gui.py
msgid "Cancel"
msgstr "取消"

#: tools/sensel_haptic_gui.py
msgid "Reset to Defaults"
msgstr "恢復預設"

#, python-brace-format
#: tools/sensel_haptic_gui.py
msgid "Preview of {label} failed: {error}"
msgstr "預覽{label}失敗：{error}"

#, python-brace-format
#: tools/sensel_haptic_gui.py
msgid "Previewing {label}. Press Save to keep it."
msgstr "正在預覽{label}。按「儲存」才會寫入。"

#: tools/sensel_haptic_gui.py
msgid "Settings read from the device. Changes are previewed immediately; press Save to write them permanently."
msgstr "已從裝置讀取設定。變更會即時預覽，按「儲存」才會永久寫入。"

#, python-brace-format
#: tools/sensel_haptic_gui.py
msgid "Saving {current}/{total}: {label}…"
msgstr "正在儲存 {current}/{total}：{label}…"

#, python-brace-format
#: tools/sensel_haptic_gui.py
msgid "Saving {label} failed: {error}"
msgstr "儲存{label}失敗：{error}"

#: tools/sensel_haptic_gui.py
msgid "Save failed"
msgstr "儲存失敗"

#: tools/sensel_haptic_gui.py
msgid "All changes saved to the device."
msgstr "所有變更已儲存到裝置。"

#: tools/sensel_haptic_gui.py
msgid "Changes discarded; the device keeps its saved settings."
msgstr "已捨棄變更；裝置保留已儲存的設定。"

#: tools/sensel_haptic_gui.py
msgid "Default preset loaded as a draft. Adjust it and press Save to keep it."
msgstr "預設預設值已載入為草稿。可繼續調整，按「儲存」才會寫入。"

#: tools/sensel_haptic_gui.py
msgid "Invalid Click Force"
msgstr "無效的點擊力度"

#: tools/sensel_haptic_gui.py
msgid "Enter a value from 1 to 255."
msgstr "請輸入 1 到 255 之間的數值。"

#: tools/sensel_haptic_gui.py
msgid "Click Force must be a value from 1 to 255."
msgstr "點擊力度必須是 1 到 255 之間的數值。"

#: tools/sensel_haptic_gui.py
msgid "Invalid TrackPoint Click Force"
msgstr "無效的 TrackPoint 點擊力度"

#: tools/sensel_haptic_gui.py
msgid "TrackPoint Click Force must be a value from 1 to 255."
msgstr "TrackPoint 點擊力度必須是 1 到 255 之間的數值。"
