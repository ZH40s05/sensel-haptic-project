+static guint
+sensel_snap_scale_level (GtkRange  *range,
+                         guint      lower,
+                         guint      upper,
+                         gboolean  *syncing)
+{
+  gdouble value;
+  gint level;
+
+  value = gtk_range_get_value (range);
+  level = (gint) floor (value + 0.5);
+  level = CLAMP (level, (gint) lower, (gint) upper);
+
+  if (!*syncing && value != (gdouble) level)
+    {
+      *syncing = TRUE;
+      gtk_range_set_value (range, level);
+      *syncing = FALSE;
+    }
+
+  return (guint) level;
+}
+
+static guint
+sensel_intensity_for_level (guint level)
+{
+  level = CLAMP (level,
+                 (guint) SENSEL_HAPTIC_LEVEL_MIN,
+                 (guint) SENSEL_HAPTIC_LEVEL_MAX);
+  return sensel_haptic_intensity_levels[level - 1];
+}
+
+static guint
+sensel_level_to_intensity (CcMousePanel *self)
+{
+  guint level;
+
+  level = sensel_snap_scale_level (GTK_RANGE (self->sensel_intensity_scale),
+                                   SENSEL_HAPTIC_LEVEL_MIN,
+                                   SENSEL_HAPTIC_LEVEL_MAX,
+                                   &self->sensel_syncing_scale);
+  return sensel_intensity_for_level (level);
+}
+
+static guint
+sensel_intensity_to_level (guint intensity)
+{
+  guint best_level = SENSEL_HAPTIC_DEFAULT_LEVEL;
+  guint best_distance = G_MAXUINT;
+
+  if (intensity == 0)
+    return SENSEL_HAPTIC_DEFAULT_LEVEL;
+
+  for (guint i = 0; i < G_N_ELEMENTS (sensel_haptic_intensity_levels); i++)
+    {
+      guint level_intensity = sensel_haptic_intensity_levels[i];
+      guint distance = intensity > level_intensity ?
+                       intensity - level_intensity : level_intensity - intensity;
+
+      if (distance < best_distance)
+        {
+          best_distance = distance;
+          best_level = i + SENSEL_HAPTIC_LEVEL_MIN;
+        }
+    }
+
+  return best_level;
+}
+
+static guint
+sensel_level_to_click_force (CcMousePanel *self)
+{
+  static const guint force_map[] = { 120, 164, 190 };
+  gint level;
+
+  level = (gint) sensel_snap_scale_level (GTK_RANGE (self->sensel_click_force_scale),
+                                          0,
+                                          G_N_ELEMENTS (force_map) - 1,
+                                          &self->sensel_syncing_click_force);
+
+  return force_map[level];
+}
+
+static guint
+sensel_click_force_to_level (guint force)
+{
+  /* Windows uses upper-bound tests when it maps a device value back to the
+   * three ComboBox entries. Preserve those thresholds for non-standard
+   * values already present in device NVM. */
+  if (force <= 120)
+    return 0;
+  if (force <= 164)
+    return 1;
+  return 2;
+}
+
+static guint
+sensel_level_to_trackpoint_force (CcMousePanel *self)
+{
+  static const guint force_map[] = { 28, 38, 60 };
+  gint level;
+
+  level = (gint) sensel_snap_scale_level (GTK_RANGE (self->sensel_trackpoint_force_scale),
+                                          0,
+                                          G_N_ELEMENTS (force_map) - 1,
+                                          &self->sensel_syncing_trackpoint_force);
+
+  return force_map[level];
+}
+
+static guint
+sensel_trackpoint_force_to_level (guint force)
+{
+  /* Windows stores the 3HB combo values directly in the Gf/2 registers:
+   * 28, 38 and 60. Its initialization code compares the doubled values
+   * against 56 and 76, which is equivalent to these raw thresholds. */
+  if (force <= 28)
+    return 0;
+  if (force <= 38)
+    return 1;
+  return 2;
+}
+
+static gboolean
+sensel_ensure_daemon (CcMousePanel *self)
+{
+  const char *pkexec = "/usr/bin/pkexec";
+  const gchar *argv[5];
+  g_autoptr(GError) error = NULL;
+
+  if (self->sensel_process)
+    return TRUE;
+
+  if (!self->sensel_hidraw)
+    {
+      update_sensel_ui (self);
+      if (!self->sensel_hidraw)
+        {
+          g_warning ("Sensel haptic touchpad was not detected");
+          return FALSE;
+        }
+    }
+
+  if (!g_file_test (SENSEL_HAPTIC_HELPER, G_FILE_TEST_IS_EXECUTABLE))
+    {
+      g_warning ("Sensel helper is not installed at %s", SENSEL_HAPTIC_HELPER);
+      return FALSE;
+    }
+
+  argv[0] = pkexec;
+  argv[1] = SENSEL_HAPTIC_HELPER;
+  argv[2] = "--daemon";
+  argv[3] = self->sensel_hidraw;
+  argv[4] = NULL;
+
+  self->sensel_process = g_subprocess_newv (
+    argv,
+    G_SUBPROCESS_FLAGS_STDIN_PIPE |
+    G_SUBPROCESS_FLAGS_STDOUT_SILENCE |
+    G_SUBPROCESS_FLAGS_STDERR_SILENCE,
+    &error);
+
+  if (!self->sensel_process)
+    {
+      g_warning ("Could not start the Sensel privileged helper: %s",
+                 error->message);
+      return FALSE;
+    }
+
+  return TRUE;
+}
+
+static void
+sensel_stop_daemon (CcMousePanel *self)
+{
+  if (self->sensel_process)
+    {
+      g_subprocess_force_exit (self->sensel_process);
+      g_clear_object (&self->sensel_process);
+    }
+}
