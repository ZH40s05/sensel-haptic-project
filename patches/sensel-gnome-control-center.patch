+static gchar *
+find_sensel_hidraw (void)
+{
+  GDir *dir;
+  const char *name;
+
+  dir = g_dir_open ("/sys/class/hidraw", 0, NULL);
+  if (!dir)
+    return NULL;
+
+  while ((name = g_dir_read_name (dir)))
+    {
+      char sysfs_path[PATH_MAX];
+      char resolved_path[PATH_MAX];
+
+      if (!g_str_has_prefix (name, "hidraw"))
+        continue;
+
+      g_snprintf (sysfs_path, sizeof sysfs_path,
+                  "/sys/class/hidraw/%s", name);
+
+      if (!realpath (sysfs_path, resolved_path))
+        continue;
+
+      /* SNSL0028 is the Sensel device exposed by the ThinkPad haptic
+       * touchpads. Keep the product-id check as a fallback because the
+       * kernel path is more stable than the hidraw number. */
+      if (!strstr (resolved_path, "SNSL") &&
+          !strstr (resolved_path, "2C2F:0028"))
+        continue;
+
+      g_dir_close (dir);
+      return g_strdup_printf ("/dev/%s", name);
+    }
+
+  g_dir_close (dir);
+  return NULL;
+}
