+static void
+update_sensel_ui (CcMousePanel *self)
+{
+  g_autofree gchar *hidraw = find_sensel_hidraw ();
+  gboolean device_changed;
+
+  device_changed = g_strcmp0 (self->sensel_hidraw, hidraw) != 0;
+
+  if (device_changed)
+    {
+      sensel_stop_daemon (self);
+      sensel_stop_state_read (self);
+      sensel_stop_read (self);
+      sensel_stop_click_read (self);
+      sensel_stop_click_write (self);
+      sensel_stop_trackpoint_write (self);
+      self->sensel_state_synced = FALSE;
+      self->sensel_value_synced = FALSE;
+      self->sensel_click_force_synced = FALSE;
+      self->sensel_trackpoint_force_synced = FALSE;
+    }
+
+  g_clear_pointer (&self->sensel_hidraw, g_free);
+  self->sensel_hidraw = g_steal_pointer (&hidraw);
+
+  /* Keep the group available whenever a touchpad exists. Both states are
+   * direct preferences rows so the native group card remains visible. */
+  gtk_widget_set_visible (GTK_WIDGET (self->sensel_group), self->have_touchpad);
+  gtk_widget_set_visible (GTK_WIDGET (self->sensel_status_row),
+                          self->sensel_hidraw == NULL);
+  gtk_widget_set_visible (GTK_WIDGET (self->sensel_haptic_feedback_row),
+                          self->sensel_hidraw != NULL);
+  gtk_widget_set_visible (GTK_WIDGET (self->sensel_intensity_row),
+                          self->sensel_hidraw != NULL);
+  gtk_widget_set_visible (GTK_WIDGET (self->sensel_click_force_row),
+                          self->sensel_hidraw != NULL);
+  gtk_widget_set_visible (GTK_WIDGET (self->sensel_trackpoint_buttons_row),
+                          self->sensel_hidraw != NULL);
+  gtk_widget_set_visible (GTK_WIDGET (self->sensel_trackpoint_force_row),
+                          self->sensel_hidraw != NULL);
+
+  if (self->sensel_hidraw && !self->sensel_state_synced)
+    {
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_intensity_scale), FALSE);
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_haptic_feedback_row), FALSE);
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_click_force_scale), FALSE);
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_trackpoint_buttons_row), FALSE);
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_trackpoint_force_scale), FALSE);
+      sensel_read_current_state (self);
+    }
+  else if (!self->sensel_hidraw)
+    {
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_intensity_scale), FALSE);
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_haptic_feedback_row), FALSE);
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_click_force_scale), FALSE);
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_trackpoint_buttons_row), FALSE);
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_trackpoint_force_scale), FALSE);
+    }
+}
