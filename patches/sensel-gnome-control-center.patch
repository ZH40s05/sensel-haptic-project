+static gboolean
+sensel_state_value (const gchar *state,
+                    const gchar *key,
+                    guint        *value)
+{
+  g_auto(GStrv) lines = g_strsplit (state ? state : "", "\n", -1);
+  gsize key_length = strlen (key);
+
+  for (guint i = 0; lines[i] != NULL; i++)
+    {
+      gchar *end = NULL;
+      guint64 parsed;
+
+      if (!g_str_has_prefix (lines[i], key) || lines[i][key_length] != '=')
+        continue;
+
+      parsed = g_ascii_strtoull (lines[i] + key_length + 1, &end, 10);
+      while (end && g_ascii_isspace (*end))
+        end++;
+
+      if (end == lines[i] + key_length + 1 || (end && *end != '\0') ||
+          parsed > G_MAXUINT)
+        return FALSE;
+
+      *value = (guint) parsed;
+      return TRUE;
+    }
+
+  return FALSE;
+}
