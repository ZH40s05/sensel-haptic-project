+static gchar *
+sensel_preferences_path (void)
+{
+  return g_build_filename (g_get_user_config_dir (),
+                            "sensel-haptic-touchpad.ini",
+                            NULL);
+}
+
+static void
+sensel_load_haptic_preferences (CcMousePanel *self,
+                                gboolean      *enabled)
+{
+  g_autoptr(GKeyFile) key_file = g_key_file_new ();
+  g_autoptr(GError) error = NULL;
+  g_autofree gchar *path = sensel_preferences_path ();
+  gint saved_intensity;
+
+  *enabled = FALSE;
+  self->sensel_saved_intensity = sensel_intensity_for_level (SENSEL_HAPTIC_DEFAULT_LEVEL);
+  self->sensel_have_saved_intensity = FALSE;
+
+  if (!g_key_file_load_from_file (key_file, path, G_KEY_FILE_NONE, NULL))
+    return;
+
+  saved_intensity = g_key_file_get_integer (key_file,
+                                            "Sensel",
+                                            "ptpIntensity",
+                                            &error);
+  if (!error && saved_intensity > 0 && saved_intensity <= 100)
+    {
+      self->sensel_saved_intensity = (guint) saved_intensity;
+      self->sensel_have_saved_intensity = TRUE;
+    }
+
+  g_clear_error (&error);
+  *enabled = g_key_file_get_boolean (key_file,
+                                     "Sensel",
+                                     "toggleSwitchHapticFeedbackIsOn",
+                                     &error);
+}
+
+static void
+sensel_save_haptic_preferences (CcMousePanel *self,
+                                guint         intensity,
+                                gboolean      enabled)
+{
+  g_autoptr(GKeyFile) key_file = g_key_file_new ();
+  g_autofree gchar *path = sensel_preferences_path ();
+  g_autofree gchar *data = NULL;
+  g_autofree gchar *directory = NULL;
+  gsize data_length;
+
+  if (intensity > 0 && intensity <= 100)
+    {
+      self->sensel_saved_intensity = intensity;
+      self->sensel_have_saved_intensity = TRUE;
+    }
+
+  g_key_file_load_from_file (key_file, path, G_KEY_FILE_NONE, NULL);
+  if (self->sensel_have_saved_intensity)
+    g_key_file_set_integer (key_file,
+                            "Sensel",
+                            "ptpIntensity",
+                            (gint) self->sensel_saved_intensity);
+  g_key_file_set_boolean (key_file,
+                          "Sensel",
+                          "toggleSwitchHapticFeedbackIsOn",
+                          enabled);
+
+  data = g_key_file_to_data (key_file, &data_length, NULL);
+  directory = g_path_get_dirname (path);
+  if (g_mkdir_with_parents (directory, 0700) != 0 ||
+      !g_file_set_contents (path, data, (gssize) data_length, NULL))
+    g_warning ("Could not save Sensel haptic preferences");
+}
+
+static void
+sensel_read_current_state_cb (GObject      *source_object,
+                              GAsyncResult *result,
+                              gpointer      user_data)
+{
+  CcMousePanel *self = CC_MOUSE_PANEL (user_data);
+  GSubprocess *process = G_SUBPROCESS (source_object);
+  g_autofree gchar *stdout_buf = NULL;
+  g_autofree gchar *stderr_buf = NULL;
+  g_autoptr(GError) error = NULL;
+  guint intensity;
+  guint click_force;
+  guint trackpoint_force;
+  guint trackpoint_buttons;
+  gboolean haptic_enabled;
+
+  if (!g_subprocess_communicate_utf8_finish (process,
+                                             result,
+                                             &stdout_buf,
+                                             &stderr_buf,
+                                             &error))
+    {
+      if (self->sensel_state_read_process == process)
+        {
+          g_clear_object (&self->sensel_state_read_process);
+          gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_haptic_feedback_row), TRUE);
+          gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_intensity_scale), TRUE);
+          gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_click_force_scale), TRUE);
+          gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_trackpoint_buttons_row), TRUE);
+          gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_trackpoint_force_scale), TRUE);
+          g_warning ("Could not read the Sensel settings: %s", error->message);
+        }
+
+      g_object_unref (self);
+      return;
+    }
+
+  if (self->sensel_state_read_process != process)
+    {
+      g_object_unref (self);
+      return;
+    }
+
+  g_clear_object (&self->sensel_state_read_process);
+
+  if (!sensel_state_value (stdout_buf, "haptic-intensity", &intensity) ||
+      !sensel_state_value (stdout_buf, "click-force", &click_force) ||
+      !sensel_state_value (stdout_buf, "trackpoint-click-force", &trackpoint_force) ||
+      !sensel_state_value (stdout_buf, "trackpoint-buttons", &trackpoint_buttons) ||
+      intensity > 100 ||
+      trackpoint_buttons > 1)
+    {
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_haptic_feedback_row), TRUE);
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_intensity_scale), TRUE);
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_click_force_scale), TRUE);
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_trackpoint_buttons_row), TRUE);
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_trackpoint_force_scale), TRUE);
+      g_warning ("Sensel returned an invalid settings state");
+      g_object_unref (self);
+      return;
+    }
+
+  haptic_enabled = intensity > 0;
+  if (haptic_enabled)
+    sensel_save_haptic_preferences (self, intensity, TRUE);
+  else
+    {
+      sensel_load_haptic_preferences (self, &haptic_enabled);
+      intensity = self->sensel_saved_intensity;
+      /* A zero register value is the hardware off state. The saved local
+       * value is only used to repopulate the level slider and to restore it
+       * if the switch is turned on again. */
+      haptic_enabled = FALSE;
+    }
+
+  self->sensel_syncing_scale = TRUE;
+  gtk_range_set_value (GTK_RANGE (self->sensel_intensity_scale),
+                       sensel_intensity_to_level (intensity));
+  self->sensel_syncing_scale = FALSE;
+
+  self->sensel_syncing_click_force = TRUE;
+  gtk_range_set_value (GTK_RANGE (self->sensel_click_force_scale),
+                       sensel_click_force_to_level (click_force));
+  self->sensel_syncing_click_force = FALSE;
+
+  self->sensel_syncing_trackpoint_force = TRUE;
+  gtk_range_set_value (GTK_RANGE (self->sensel_trackpoint_force_scale),
+                       sensel_trackpoint_force_to_level (trackpoint_force));
+  self->sensel_syncing_trackpoint_force = FALSE;
+
+  self->sensel_syncing_haptic_feedback = TRUE;
+  adw_switch_row_set_active (self->sensel_haptic_feedback_row, haptic_enabled);
+  self->sensel_syncing_haptic_feedback = FALSE;
+
+  self->sensel_syncing_trackpoint_buttons = TRUE;
+  adw_switch_row_set_active (self->sensel_trackpoint_buttons_row,
+                             trackpoint_buttons != 0);
+  self->sensel_syncing_trackpoint_buttons = FALSE;
+
+  self->sensel_value_synced = TRUE;
+  self->sensel_click_force_synced = TRUE;
+  self->sensel_trackpoint_force_synced = TRUE;
+  self->sensel_state_synced = TRUE;
+  gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_haptic_feedback_row), TRUE);
+  gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_intensity_scale), haptic_enabled);
+  gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_click_force_scale), TRUE);
+  gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_trackpoint_buttons_row), TRUE);
+  gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_trackpoint_force_scale),
+                            trackpoint_buttons != 0);
+
+  g_object_unref (self);
+}
+
+static void
+sensel_read_current_state (CcMousePanel *self)
+{
+  const char *pkexec = "/usr/bin/pkexec";
+  const gchar *argv[5];
+  g_autoptr(GError) error = NULL;
+
+  if (!self->sensel_hidraw || self->sensel_state_read_process ||
+      self->sensel_state_synced)
+    return;
+
+  if (!g_file_test (SENSEL_HAPTIC_HELPER, G_FILE_TEST_IS_EXECUTABLE))
+    {
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_haptic_feedback_row), TRUE);
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_intensity_scale), TRUE);
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_click_force_scale), TRUE);
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_trackpoint_buttons_row), TRUE);
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_trackpoint_force_scale), TRUE);
+      g_warning ("Sensel helper is not installed at %s", SENSEL_HAPTIC_HELPER);
+      return;
+    }
+
+  argv[0] = pkexec;
+  argv[1] = SENSEL_HAPTIC_HELPER;
+  argv[2] = "--get-state";
+  argv[3] = self->sensel_hidraw;
+  argv[4] = NULL;
+
+  self->sensel_state_read_process = g_subprocess_newv (
+    argv,
+    G_SUBPROCESS_FLAGS_STDOUT_PIPE |
+    G_SUBPROCESS_FLAGS_STDERR_SILENCE,
+    &error);
+
+  if (!self->sensel_state_read_process)
+    {
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_haptic_feedback_row), TRUE);
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_intensity_scale), TRUE);
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_click_force_scale), TRUE);
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_trackpoint_buttons_row), TRUE);
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_trackpoint_force_scale), TRUE);
+      g_warning ("Could not start the Sensel state helper: %s", error->message);
+      return;
+    }
+
+  g_subprocess_communicate_utf8_async (self->sensel_state_read_process,
+                                       NULL,
+                                       NULL,
+                                       sensel_read_current_state_cb,
+                                       g_object_ref (self));
+}
+
+static void
+sensel_send_intensity (CcMousePanel *self,
+                       guint         intensity)
+{
+  GOutputStream *stdin_pipe;
+  g_autofree gchar *value = NULL;
+  g_autoptr(GError) error = NULL;
+  gsize bytes_written;
+
+  if (!sensel_ensure_daemon (self))
+    return;
+
+  value = g_strdup_printf ("%u\n", intensity);
+  stdin_pipe = g_subprocess_get_stdin_pipe (self->sensel_process);
+
+  if (!g_output_stream_write_all (stdin_pipe,
+                                  value,
+                                  strlen (value),
+                                  &bytes_written,
+                                  NULL,
+                                  &error))
+    {
+      g_warning ("Could not apply the Sensel setting: %s", error->message);
+      sensel_stop_daemon (self);
+      return;
+    }
+
+  self->sensel_value_synced = TRUE;
+}
+
+static void
+sensel_intensity_pressed_cb (CcMousePanel *self,
+                             gint          n_press,
+                             double        x,
+                             double        y)
+{
+  (void) n_press;
+  (void) x;
+  (void) y;
+
+  /* Start pkexec while the pointer is being pressed, so the first slider
+   * movement can be written to the already-open stdin pipe. */
+  sensel_ensure_daemon (self);
+}
+
+static void
+sensel_intensity_changed_cb (CcMousePanel *self)
+{
+  guint intensity;
+
+  if (self->sensel_syncing_scale)
+    return;
+
+  intensity = sensel_level_to_intensity (self);
+  self->sensel_pending_intensity = intensity;
+  sensel_save_haptic_preferences (self, intensity, TRUE);
+  sensel_send_intensity (self, self->sensel_pending_intensity);
+}
+
+static void
+sensel_intensity_released_cb (CcMousePanel *self,
+                              gint          n_press,
+                              double        x,
+                              double        y)
+{
+  (void) n_press;
+  (void) x;
+  (void) y;
+
+  /* Always resend the final level on release, even when the pointer stopped
+   * between two discrete slider levels. */
+  sensel_intensity_changed_cb (self);
+}
+
+static void
+sensel_haptic_feedback_changed_cb (CcMousePanel *self)
+{
+  gboolean enabled;
+  guint intensity;
+
+  if (self->sensel_syncing_haptic_feedback || !self->sensel_hidraw)
+    return;
+
+  enabled = adw_switch_row_get_active (self->sensel_haptic_feedback_row);
+  if (enabled)
+    {
+      intensity = self->sensel_saved_intensity;
+      if (!self->sensel_have_saved_intensity)
+        intensity = sensel_intensity_for_level (SENSEL_HAPTIC_DEFAULT_LEVEL);
+
+      /* Migrate arbitrary/raw values from older builds to the nearest of
+       * the ten supported non-linear levels before writing them back. */
+      intensity = sensel_intensity_for_level (sensel_intensity_to_level (intensity));
+
+      self->sensel_syncing_scale = TRUE;
+      gtk_range_set_value (GTK_RANGE (self->sensel_intensity_scale),
+                           sensel_intensity_to_level (intensity));
+      self->sensel_syncing_scale = FALSE;
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_intensity_scale), TRUE);
+      sensel_save_haptic_preferences (self, intensity, TRUE);
+      sensel_send_intensity (self, intensity);
+    }
+  else
+    {
+      intensity = sensel_level_to_intensity (self);
+      if (intensity > 0)
+        {
+          self->sensel_saved_intensity = intensity;
+          self->sensel_have_saved_intensity = TRUE;
+        }
+
+      gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_intensity_scale), FALSE);
+      /* Do not overwrite the remembered value with zero when turning the
+       * switch off. Zero belongs only in the device register. */
+      sensel_save_haptic_preferences (self,
+                                      self->sensel_saved_intensity,
+                                      FALSE);
+      sensel_send_intensity (self, 0);
+    }
+}
+
+static void
+sensel_trackpoint_buttons_write_cb (GObject      *source_object,
+                                    GAsyncResult *result,
+                                    gpointer      user_data)
+{
+  CcMousePanel *self = CC_MOUSE_PANEL (user_data);
+  GSubprocess *process = G_SUBPROCESS (source_object);
+  g_autoptr(GError) error = NULL;
+
+  if (self->sensel_trackpoint_buttons_write_process != process)
+    {
+      g_object_unref (self);
+      return;
+    }
+
+  if (!g_subprocess_wait_check_finish (process, result, &error))
+    g_warning ("Could not apply the Sensel TrackPoint button mode: %s",
+               error ? error->message : "helper exited unsuccessfully");
+
+  g_clear_object (&self->sensel_trackpoint_buttons_write_process);
+  g_object_unref (self);
+}
+
+static void
+sensel_trackpoint_buttons_changed_cb (CcMousePanel *self)
+{
+  const char *pkexec = "/usr/bin/pkexec";
+  const gchar *argv[6];
+  g_autofree gchar *enabled_string = NULL;
+  g_autoptr(GError) error = NULL;
+  gboolean enabled;
+
+  if (self->sensel_syncing_trackpoint_buttons || !self->sensel_hidraw)
+    return;
+
+  enabled = adw_switch_row_get_active (self->sensel_trackpoint_buttons_row);
+  gtk_widget_set_sensitive (GTK_WIDGET (self->sensel_trackpoint_force_scale), enabled);
+
+  if (self->sensel_trackpoint_buttons_write_process)
+    {
+      g_subprocess_force_exit (self->sensel_trackpoint_buttons_write_process);
+      g_clear_object (&self->sensel_trackpoint_buttons_write_process);
+    }
+
+  enabled_string = g_strdup_printf ("%u", enabled ? 1 : 0);
+  argv[0] = pkexec;
+  argv[1] = SENSEL_HAPTIC_HELPER;
+  argv[2] = "--set-trackpoint-buttons";
+  argv[3] = self->sensel_hidraw;
+  argv[4] = enabled_string;
+  argv[5] = NULL;
+
+  self->sensel_trackpoint_buttons_write_process = g_subprocess_newv (
+    argv,
+    G_SUBPROCESS_FLAGS_STDOUT_SILENCE |
+    G_SUBPROCESS_FLAGS_STDERR_SILENCE,
+    &error);
+
+  if (!self->sensel_trackpoint_buttons_write_process)
+    {
+      g_warning ("Could not start the Sensel TrackPoint button helper: %s",
+                 error->message);
+      return;
+    }
+
+  g_subprocess_wait_check_async (self->sensel_trackpoint_buttons_write_process,
+                                 NULL,
+                                 sensel_trackpoint_buttons_write_cb,
+                                 g_object_ref (self));
+}
+
+static void
+sensel_click_force_write_cb (GObject      *source_object,
+                             GAsyncResult *result,
+                             gpointer      user_data)
+{
+  CcMousePanel *self = CC_MOUSE_PANEL (user_data);
+  GSubprocess *process = G_SUBPROCESS (source_object);
+  g_autoptr(GError) error = NULL;
+  guint pending_force;
+  gboolean success;
+
+  success = g_subprocess_wait_check_finish (process, result, &error);
+
+  if (self->sensel_click_write_process != process)
+    {
+      g_object_unref (self);
+      return;
+    }
+
+  g_clear_object (&self->sensel_click_write_process);
+
+  if (!success)
+    {
+      self->sensel_click_force_synced = FALSE;
+      g_warning ("Could not apply the Sensel click force: %s",
+                 error ? error->message : "helper exited unsuccessfully");
+    }
+  else
+    {
+      self->sensel_click_force_synced = TRUE;
+    }
+
+  pending_force = self->sensel_pending_click_force;
+  self->sensel_pending_click_force = 0;
+  if (pending_force != 0)
+    sensel_send_click_force (self, pending_force);
+
+  g_object_unref (self);
+}
+
+static void
+sensel_send_click_force (CcMousePanel *self,
+                         guint         force)
+{
+  const char *pkexec = "/usr/bin/pkexec";
+  const gchar *argv[6];
+  g_autofree gchar *force_string = NULL;
+  g_autoptr(GError) error = NULL;
+
+  if (force != 120 && force != 164 && force != 190)
+    return;
+
+  if (!self->sensel_hidraw)
+    {
+      update_sensel_ui (self);
+      if (!self->sensel_hidraw)
+        {
+          g_warning ("Sensel haptic touchpad was not detected");
+          return;
+        }
+    }
+
+  if (self->sensel_click_write_process)
+    {
+      self->sensel_pending_click_force = force;
+      return;
+    }
+
+  if (!g_file_test (SENSEL_HAPTIC_HELPER, G_FILE_TEST_IS_EXECUTABLE))
+    {
+      g_warning ("Sensel helper is not installed at %s", SENSEL_HAPTIC_HELPER);
+      return;
+    }
+
+  force_string = g_strdup_printf ("%u", force);
+  argv[0] = pkexec;
+  argv[1] = SENSEL_HAPTIC_HELPER;
+  argv[2] = "--set-click-force";
+  argv[3] = self->sensel_hidraw;
+  argv[4] = force_string;
+  argv[5] = NULL;
+
+  self->sensel_click_write_process = g_subprocess_newv (
+    argv,
+    G_SUBPROCESS_FLAGS_STDOUT_SILENCE |
+    G_SUBPROCESS_FLAGS_STDERR_SILENCE,
+    &error);
+
+  if (!self->sensel_click_write_process)
+    {
+      g_warning ("Could not start the Sensel click-force helper: %s",
+                 error->message);
+      return;
+    }
+
+  g_subprocess_wait_check_async (self->sensel_click_write_process,
+                                 NULL,
+                                 sensel_click_force_write_cb,
+                                 g_object_ref (self));
+}
+
+static void
+sensel_click_force_changed_cb (CcMousePanel *self)
+{
+  if (self->sensel_syncing_click_force)
+    return;
+
+  sensel_send_click_force (self, sensel_level_to_click_force (self));
+}
