/* Allow the local desktop user to adjust only the Sensel haptic helper
 * without an authentication prompt. The helper itself validates the device,
 * command and value before it performs the private HID register write. */
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.policykit.exec")
        return;

    if (action.lookup("program") !== "/usr/local/libexec/sensel-haptic-set")
        return;

    if (subject.local && subject.active && subject.isInGroup("wheel"))
        return polkit.Result.YES;
});
